@startuml clocks
title Clocks - Observer pattern
skinparam classAttributeIconSize 0

package "java.util" {
  class Observable {
    +addObserver(o: Observer)
    +deleteObserver(o: Observer)
    #setChanged()
    +notifyObservers(arg: Object)
  }
  interface Observer {
    +update(o: Observable, arg: Object)
  }
}

package independent_clocks {
  class ClockTimer {
    -period: int
    +ClockTimer(period: int)
    +getPeriod(): int
  }

  abstract class Clock {
    +show()
  }

  class DigitalClock {
    -hoursOffsetTimeZone: int
    +DigitalClock(hoursOffsetTimeZone: int, worldPlace: String)
    +updateClockLabel()
  }

  class AnalogClock {
    -hoursOffsetTimeZone: int
    -worldPlace: String
    +AnalogClock(hoursOffsetTimeZone: int, worldPlace: String)
  }

  class CountdownTimer {
    ~time: Duration
    +CountdownTimer(time: Duration, timer: ClockTimer)
    -format(): String
  }

  class StopWatch {
    ~time: Duration
    -running: boolean
    +StopWatch(timer: ClockTimer)
    -format(): String
  }
}

ClockTimer --|> Observable
Clock ..|> Observer

DigitalClock --|> Clock
AnalogClock --|> Clock
CountdownTimer --|> Clock
StopWatch --|> Clock

CountdownTimer "0..*" --> "1" ClockTimer : timer
StopWatch "0..*" --> "1" ClockTimer : timer

@enduml
